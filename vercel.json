{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "package.json", "use": "@vercel/next" },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 300, "excludeFiles": "{legacy/**,app/**,lib/**,node_modules/**,.next/**,modelos/**,imagens/**}" }
    }
  ],
  "rewrites": [
    { "source": "/api/cliente", "destination": "/api/index.py?rota=cliente" },
    { "source": "/api/extrair", "destination": "/api/index.py?rota=extrair" },
    { "source": "/api/consolidar", "destination": "/api/index.py?rota=consolidar" },
    { "source": "/api/identificar", "destination": "/api/index.py?rota=identificar" }
  ]
}
